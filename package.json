{
  "name": "keypass",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts",
    "export:web": "expo export --platform web",
    "electron:dev": "concurrently -k -s first \"expo start --web --port 8099\" \"wait-on http://localhost:8099 && cross-env ELECTRON_START_URL=http://localhost:8099 electron ./electron/main.cjs\"",
    "electron:start": "electron ./electron/main.cjs",
    "electron:pack": "npm run export:web && electron-builder --dir --publish never",
    "electron:build": "npm run export:web && electron-builder --publish never",
    "electron:build:win": "npm run export:web && electron-builder --win --publish never",
    "electron:build:mac": "npm run export:web && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.10",
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "electron-updater": "^6.8.9",
    "expo": "~57.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.keypass.app",
    "productName": "Keypass",
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hollywoodj",
      "repo": "Keypass"
    }
  }
}
